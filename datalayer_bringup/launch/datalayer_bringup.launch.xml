<launch>
    <let name="robot_description_content" value="$(command '$(find-exec xacro) $(find-pkg-share ctrlx_hardware_interface)/urdf/ctrlx_hardware_interface.urdf')"/>

    <!--robot_state_pub_node-->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="both">
        <param name="robot_description" value="$(var robot_description_content)"/>
    </node>

</launch>
